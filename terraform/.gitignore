# Provider plugins and modules downloaded by terraform init
.terraform/

# State files: can contain secrets and real resource details
*.tfstate
*.tfstate.*

# Saved plan files
tfplan
*.tfplan

# Variable files that often hold secrets
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc